# Local build by default. For GHCR use ghcr.io/<lowercase-owner>/<repo>:main
TSMUSICBOT_IMAGE=teamspeak-music-mirror:local
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000

# Host paths; ./data includes config, database, cookies, uploads and logs.
DATA_PATH=./data
# Optional external media library, mounted read-only at /mnt/media.
MEDIA_PATH=./media

# Optional outbound HTTP proxy. Leave empty for direct access.
# Example: HTTP_PROXY=http://proxy.example.com:8080
HTTP_PROXY=
HTTPS_PROXY=
# Always bypass the proxy for the embedded music APIs.
NO_PROXY=localhost,127.0.0.1,::1

# Mirror: use DATA_PATH/mirror.json with {"sourceBotId":"…","targetBotId":"…"}.
# Optional container env overrides (both IDs must be set together and nonempty):
# MIRROR_SOURCE_BOT_ID=your-source-bot-id
# MIRROR_TARGET_BOT_ID=your-target-bot-id
# MIRROR_CONFIG_PATH=/app/data/mirror.json
# These are comments: the default compose deliberately does not emit empty IDs.
# To use env overrides, add the variables to the service environment in an
# override file; setting them in this .env alone does not forward them.
